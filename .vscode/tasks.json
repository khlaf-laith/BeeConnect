{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "BeeConnect Backend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"backend",
				"run",
				"start:dev"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "BeeConnect Backend (SQLite)",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"backend",
				"run",
				"start:dev"
			],
			"options": {
				"env": {
					"DB_TYPE": "sqlite",
					"DB_NAME": "dev.sqlite"
				}
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "BeeConnect Frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"beeconnect",
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}