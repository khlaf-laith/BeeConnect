NODE_ENV=development

APP_NAME=BeeConnect
APP_VERSION=1.0
# Generate a random secret with at least 32 bytes before starting the backend.
APP_SECRET=
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIRECTORY=uploads
# Optional one-time secret for initial administrator setup; keep it server-side.
ADMIN_SETUP_SECRET=

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=beeconnect
DB_TYPE=mysql

# PUSHER
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

# Google auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_CALLBACK=